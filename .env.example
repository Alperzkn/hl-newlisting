# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
HL_API_URL=https://api.hyperliquid.xyz
POLL_INTERVAL_MS=1000
DEX_POLL_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MIN=60
STATE_FILE_PATH=./data/known-assets.json
TELEGRAM_HEARTBEAT_CHAT_ID=
ENABLE_DESKTOP_SOUND=false
LOG_LEVEL=info

# --- alt.fun / HyperEVM watcher (optional) ---
# When ENABLE_ALTFUN=true, the service ALSO watches a HyperEVM AMM factory for
# PairCreated events and notifies on each new pool. alt.fun graduations migrate
# to a HyperSwap pool, so pointing this at the HyperSwap V2 factory captures
# every graduation plus any other token opening a HyperSwap pool. Narrow with
# ALTFUN_QUOTE_TOKEN to only notify on pools paired against a specific quote
# (e.g., USDC) — leave empty to alert on every pair created.
ENABLE_ALTFUN=false
# alt.fun's pair factory on HyperEVM (Uniswap V3 fork). Verify on the HyperEVM
# explorer before trusting any address you find online.
ALTFUN_FACTORY=0xff7b3e8c00e57ea31477c32a5b52a58eea47b072
# "v3" = Uniswap V3 PoolCreated event (alt.fun's factory style).
# "v2" = Uniswap V2 PairCreated event (HyperSwap V2, etc.).
ALTFUN_FACTORY_KIND=v3
# Optional. On HyperEVM, alt.fun pools pair the new token against WHYPE
# (wrapped HYPE) at 0x5555555555555555555555555555555555555555. When set, the
# watcher only emits events where the new pool includes this token. Leave
# empty to be alerted on every pool created by the factory.
ALTFUN_QUOTE_TOKEN=0x5555555555555555555555555555555555555555
ALTFUN_RPC_URL=https://rpc.hyperliquid.xyz/evm
ALTFUN_POLL_INTERVAL_MS=15000
ALTFUN_LABEL=alt.fun
# {token} and {pair} are substituted with the new token and the pool address.
ALTFUN_TRADING_URL_TEMPLATE=https://alt.fun/coin/{token}
# Defaults to "<dir-of-STATE_FILE_PATH>/altfun-state.json".
ALTFUN_STATE_FILE_PATH=
