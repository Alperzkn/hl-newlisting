# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
HL_API_URL=https://api.hyperliquid.xyz
POLL_INTERVAL_MS=1000
DEX_POLL_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MIN=60
STATE_FILE_PATH=./data/known-assets.json
TELEGRAM_HEARTBEAT_CHAT_ID=
ENABLE_DESKTOP_SOUND=false
LOG_LEVEL=info

# --- alt.fun graduation watcher (optional) ---
# When ENABLE_ALTFUN=true, the service ALSO watches alt.fun's Bonding contract
# on HyperEVM for TokenGraduated events — the authoritative graduation signal
# per https://docs.alt.fun/integrations. Each event names the graduated token
# and its new AMM pool directly, so there's no heuristic guesswork.
ENABLE_ALTFUN=false
# alt.fun Bonding contract (lifecycle / curve state). Verify on the HyperEVM
# explorer before trusting an address you find online.
ALTFUN_BONDING_CONTRACT=0xb68811BcC0e4FcD825aA49F9453b065ddF752FcB
ALTFUN_RPC_URL=https://rpc.hyperliquid.xyz/evm
ALTFUN_POLL_INTERVAL_MS=15000
ALTFUN_LABEL=alt.fun
# {token} and {pair} are substituted with the graduated token and pool address.
ALTFUN_TRADING_URL_TEMPLATE=https://alt.fun/coin/{token}
# Defaults to "<dir-of-STATE_FILE_PATH>/altfun-state.json".
ALTFUN_STATE_FILE_PATH=
