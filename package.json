{
  "name": "hl-newlisting",
  "version": "0.1.0",
  "private": true,
  "description": "Detects newly-listed Hyperliquid perp and spot assets via 1Hz REST polling and notifies you on Telegram (with optional macOS desktop sound).",
  "license": "MIT",
  "author": "alperzkn",
  "repository": {
    "type": "git",
    "url": "https://github.com/alperzkn/hl-newlisting.git"
  },
  "homepage": "https://github.com/alperzkn/hl-newlisting#readme",
  "bugs": {
    "url": "https://github.com/alperzkn/hl-newlisting/issues"
  },
  "keywords": [
    "hyperliquid",
    "crypto",
    "trading",
    "alerts",
    "telegram",
    "perp",
    "spot",
    "new-listing",
    "notifications"
  ],
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
